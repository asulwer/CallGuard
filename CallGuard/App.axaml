<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CallGuard.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the phone's light/dark setting. -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="OkBrush" Color="#2E7D32" />
          <SolidColorBrush x:Key="ProblemBrush" Color="#C62828" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="OkBrush" Color="#81C784" />
          <SolidColorBrush x:Key="ProblemBrush" Color="#EF9A9A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
    </Style>
    <Style Selector="Button.wide">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Styles>
</Application>
